datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ผู้ใช้ระบบ (Login/Logout)
model User {
  id          String    @id @default(uuid())
  username    String    @unique
  password    String    // hashed with bcrypt
  displayName String
  firstName   String?   // ชื่อจริง
  lastName    String?   // นามสกุล
  position    String?   // ตำแหน่ง เช่น ผู้จัดการสาขา, เจ้าหน้าที่ขาย
  phone       String?   // เบอร์โทรศัพท์
  role        String    // ADMIN, BRANCH, SUPPLIER
  companyId   String?
  company     Company?  @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  isActive    Boolean   @default(true)
  mustChangePassword Boolean @default(false) // บังคับเปลี่ยนรหัสผ่านตอน login ครั้งถัดไป
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ข้อมูลบริษัท เช่น EV7, GI
model Company {
  id          String    @id @default(uuid())
  code        String    @unique // EV7, GI
  name        String
  taxId       String?
  address     String?
  users       User[]
  branches    Branch[]
  vehicles    Vehicle[]
  jobs        Job[]
  invoices    Invoice[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ข้อมูลสาขา
model Branch {
  id          String    @id @default(uuid())
  companyId   String
  company     Company   @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  code        String    @unique // เช่น BKK-HO, BKK-RNG, BKK-RM9
  name        String    // พระราม 9, รังสิต, เชียงใหม่
  address     String?
  phone       String?
  latitude    Float?    // พิกัด GPS สำหรับคำนวณระยะทาง
  longitude   Float?
  vehicles    Vehicle[]
  users       User[]
  jobs        Job[]     @relation("BranchJobs")
  originJobs  Job[]     @relation("OriginBranchJobs")
  destJobs    Job[]     @relation("DestBranchJobs")
  supplierVendorCodes SupplierVendorCode[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([companyId, code])
}

// ข้อมูล Supplier คู่ค้า
model Supplier {
  id            String             @id @default(uuid())
  name          String
  code          String             @unique
  taxId         String?
  phone         String?
  email         String?
  address       String?
  services      String             // เช่น "CAR_WASH,VEHICLE_SLIDE"
  bankName      String?
  bankAccount   String?
  vatType       String             @default("NO_VAT") // VAT_7, NO_VAT
  vatRate       Float              @default(0.0)      // 0.07, 0.0
  showroomLabel String?            // สาขาโชว์รูมประจำ เช่น "ศาลายา", "เลียบด่วน รามอินทรา, วิภาวดี"
  d365PartyNumber String?          // เลข Party กลาง (Global Address Book) ใน D365 ใช้ดึงรหัส Vendor ทุกสาขา
  isActive      Boolean            @default(true)
  users         User[]
  jobs          Job[]
  invoices      Invoice[]
  rateItems     SupplierRateItem[]
  vendorCodes   SupplierVendorCode[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
}

// รายการอัตราค่าบริการของ Supplier (Rate Card Template Item)
model SupplierRateItem {
  id          String   @id @default(uuid())
  supplierId  String
  supplier    Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  serviceCode String   // เช่น WASH_NORMAL, WASH_AND_COAT, POLISH_STAINS
  priceType   String   @default("FIXED") // FIXED, RANGE
  price       Float    // ราคาหลัก หรือราคาเริ่มต้น
  minPrice    Float?   // ราคาต่ำสุด (กรณี RANGE)
  maxPrice    Float?   // ราคาสูงสุด (กรณี RANGE)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([supplierId, serviceCode])
  @@index([supplierId])
}

// รหัส Vendor ของ Supplier ใน D365 แยกตามสาขา (รหัสสาขา = Legal Entity ใน D365 เช่น GI, GI02)
model SupplierVendorCode {
  id          String    @id @default(uuid())
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  branchId    String
  branch      Branch    @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vendorCode  String    // VendorAccountNumber เช่น V000357
  vendorName  String?   // ชื่อ Vendor ใน D365 (ไว้ตรวจว่าตรงเจ้า)
  source      String    @default("MANUAL") // MANUAL, D365_SYNC
  verifiedAt  DateTime? // เวลาที่ยืนยันกับ D365 ล่าสุด
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([supplierId, branchId])
  @@index([branchId])
}

// ข้อมูลรถยนต์ Interface มาจาก External Stock System
model Vehicle {
  vin             String        @id // VIN เป็น Unique ID
  model           String        // เช่น BYD Atto 3, MG4, NETA V
  color           String
  companyId       String
  company         Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  currentBranchId String
  currentBranch   Branch        @relation(fields: [currentBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  vehicleType     String        // Sedan, SUV, Commercial, Hatchback
  licensePlate    String?
  mileage         Int?
  status          String        @default("AVAILABLE") // AVAILABLE, IN_TRANSIT, IN_WASH, OUT_OF_STOCK

  // D365 Integration (sync จาก BPC_InventOnHand)
  source          String        @default("MANUAL") // MANUAL | D365
  d365ItemId      String?       // รหัสสินค้าใน D365 เช่น GI-0700380
  d365SiteId      String?       // InventSiteId เช่น GI01
  d365WarehouseId String?       // InventLocationId เช่น 62008
  d365Reserved    Boolean       @default(false) // ReservPhysical > 0 (แสดงผลเท่านั้น ยังสั่งงานได้)
  lastSyncedAt    DateTime?
  outOfStockAt    DateTime?

  jobs            Job[]
  carWashItems    CarWashItem[]
  slideLogs       VehicleSlideLog[]
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([companyId])
  @@index([currentBranchId])
  @@index([status])
  @@index([source])
}

// งานสั่งงาน Supplier
model Job {
  id               String        @id @default(uuid())
  jobNumber        String        @unique // CW-202609-001, VS-202609-001
  jobType          String        // CAR_WASH, VEHICLE_SLIDE
  status           String        @default("IN_PROGRESS") // PENDING_SUPPLIER, IN_PROGRESS, WAITING_APPROVAL, APPROVED, REJECTED, INVOICED, CANCELLED
  companyId        String
  company          Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branchId         String
  branch           Branch        @relation("BranchJobs", fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  supplierId       String
  supplier         Supplier      @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // Vehicle Slide ข้อมูล
  vin              String?
  vehicle          Vehicle?      @relation(fields: [vin], references: [vin], onDelete: NoAction, onUpdate: NoAction)
  originBranchId   String?
  originBranch     Branch?       @relation("OriginBranchJobs", fields: [originBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  destBranchId     String?
  destBranch       Branch?       @relation("DestBranchJobs", fields: [destBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customDestAddress String?      // ที่อยู่ปลายทางกรณีเลือกจุดบนแผนที่
  customDestLat     Float?       // ละติจูดปลายทาง
  customDestLng     Float?       // ลองจิจูดปลายทาง
  customOriginAddress String?    // ที่อยู่จุดรับรถกรณีปักหมุดเอง (ไม่ใช่ที่อยู่สาขา)
  customOriginLat     Float?     // ละติจูดจุดรับรถ
  customOriginLng     Float?     // ลองจิจูดจุดรับรถ
  pickupDateTime   DateTime?
  deliveryDateTime DateTime?
  contactPerson    String?
  contactPhone     String?
  transferReason   String?

  // Car Wash รายการรถหลายคัน
  carWashItems     CarWashItem[]

  // การตรวจรับและส่งมอบ — Snapshot ข้อมูลผู้สั่งงาน ณ เวลาที่สร้าง
  requestedById    String?       // FK → User.id ของผู้สั่งงาน
  requestedBy      String?       // ชื่อ-นามสกุลเต็ม (snapshot)
  requesterPosition String?      // ตำแหน่ง ณ ขณะสั่งงาน (snapshot)
  requesterPhone   String?       // เบอร์โทร ณ ขณะสั่งงาน (snapshot)
  completedAt      DateTime?
  approvedAt       DateTime?
  approvedBy       String?
  rejectReason     String?

  // ยืนยันตัวรถก่อนเริ่มงาน (Vehicle Slide — ระดับใบงาน)
  verifiedAt       DateTime?
  verifiedBy       String?

  // รูปหลักฐาน
  evidences        JobEvidence[]

  // บันทึกกิจกรรม / Timeline
  activities       JobActivity[]

  // บันทึก Log การสไลด์ย้ายรถ
  slideLogs        VehicleSlideLog[]

  // ค่าใช้จ่ายและการวางบิล
  estimatedCost    Float?
  actualCost       Float?
  invoiceId        String?
  invoice          Invoice?      @relation(fields: [invoiceId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  // บันทึกการเชื่อมโยง Purchase Order (D365)
  d365PoNumber     String?       // เช่น PO126000086
  d365PoStatus     String?       // SUCCESS, FAILED, PENDING
  d365PoMessage    String?       // ข้อความตอบกลับจาก D365 FO
  d365PoSentAt     DateTime?     // เวลาที่ส่งเปิด PO

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([companyId, status])
  @@index([supplierId, status])
  @@index([branchId])
  @@index([originBranchId])
  @@index([destBranchId])
  @@index([status])
  @@index([createdAt])
  @@index([vin])
  @@index([invoiceId])
  @@index([d365PoNumber])
}

// รายการคันรถใน Car Wash Order
model CarWashItem {
  id              String   @id @default(uuid())
  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vin             String
  vehicle         Vehicle  @relation(fields: [vin], references: [vin], onDelete: NoAction, onUpdate: NoAction)
  actualWashDate  DateTime // วันที่ปฏิบัติงานจริงของแต่ละ VIN
  washType        String   @default("STANDARD") // STANDARD, DEEP_CLEAN, POLISH
  unitPrice       Float    @default(150.0)
  status          String   @default("PENDING")
  remarks         String?

  // ยืนยันตัวรถ (VIN 6 ตัวท้าย / ทะเบียน + รูปถ่าย) ก่อนเริ่มงาน
  verifiedAt      DateTime?
  verifiedBy      String?
  verifyMethod    String?  // VIN | PLATE

  @@index([jobId])
  @@index([vin])
}

// รูปภาพหลักฐานงาน
model JobEvidence {
  id           String   @id @default(uuid())
  jobId        String
  job          Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  vin          String?
  photoUrl     String
  caption      String?
  evidenceType String   // BEFORE, AFTER, PICKUP, DROPOFF
  uploadedAt   DateTime @default(now())

  @@index([jobId])
}

// บันทึกกิจกรรม / Timeline ของงาน
model JobActivity {
  id          String   @id @default(uuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  action      String   // ITEM_COMPLETED, ITEM_REJECTED, JOB_APPROVED, JOB_REJECTED, JOB_CANCELLED, JOB_CREATED, EVIDENCE_UPLOADED
  actor       String?  // ชื่อผู้ทำ เช่น "CleanPro Supplier", "สาขาพระราม 9"
  actorRole   String?  // SUPPLIER, BRANCH, SYSTEM
  itemId      String?  // FK → CarWashItem.id (ถ้าเป็น event ระดับคัน)
  vin         String?  // VIN ของรถที่เกี่ยวข้อง
  description String   // ข้อความอธิบายเหตุการณ์
  metadata    String?  // JSON string สำหรับข้อมูลเพิ่มเติม เช่น { photoCount: 3, reason: "..." }
  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([createdAt])
}

// ใบวางบิล Invoice
model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique // INV-EV7-202609-001, INV-GI-202609-001
  supplierId    String
  supplier      Supplier      @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  companyId     String
  company       Company       @relation(fields: [companyId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  status        String        @default("SUBMITTED") // DRAFT, SUBMITTED, VERIFIED, PAID, CANCELLED
  invoiceDate   DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Float
  vatAmount     Float
  totalAmount   Float
  notes         String?
  jobs          Job[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([companyId, status])
  @@index([supplierId, status])
  @@index([createdAt])
}

// บันทึก Audit Log — ใครทำอะไรเมื่อไหร่ในระบบ
model AuditLog {
  id          String   @id @default(uuid())
  userId      String?  // FK → User (nullable สำหรับ system events)
  userName    String?  // Snapshot ชื่อผู้กระทำ ณ เวลานั้น
  userRole    String?  // MASTER, ADMIN, BRANCH, SUPPLIER
  supplierId  String?  // ถ้า action เกี่ยวกับ Supplier
  action      String   // LOGIN, LOGOUT, CREATE_JOB, APPROVE_JOB, REJECT_JOB, CREATE_INVOICE, UPDATE_ITEM_STATUS, etc.
  entityType  String?  // Job, Invoice, Vehicle, User, CarWashItem
  entityId    String?  // ID ของ record ที่ถูกกระทำ
  description String   // ข้อความอธิบายสิ่งที่เกิดขึ้น
  metadata    String?  // JSON string สำหรับข้อมูลเพิ่มเติม
  ipAddress   String?  // IP Address ของผู้ใช้
  userAgent   String?  // Browser / Device info
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([supplierId])
  @@index([action])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// บันทึก Log การสไลด์ย้ายรถ (Vehicle Slide Movement Log)
model VehicleSlideLog {
  id             String    @id @default(uuid())
  vin            String
  vehicle        Vehicle?  @relation(fields: [vin], references: [vin], onDelete: NoAction, onUpdate: NoAction)
  jobId          String
  job            Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobNumber      String
  action         String    // CREATED, PICKUP_VERIFIED, DELIVERED, APPROVED, CANCELLED
  
  // ต้นทาง (Origin)
  originBranchId String?
  originName     String    // เช่น "สาขา GI11 (พระนครศรีอยุธยา)" หรือที่อยู่จุดรับรถ
  originAddress  String?
  originLat      Float?
  originLng      Float?

  // ปลายทาง (Destination)
  destBranchId   String?
  destName       String    // เช่น "สาขา GI01 (กาญจนาภิเษก-บางแค)" หรือที่อยู่ปลายทาง
  destAddress    String?
  destLat        Float?
  destLng        Float?

  distance       Float?    // ระยะทาง (กิโลเมตร)
  supplierId     String?
  supplierName   String?
  
  actorId        String?
  actorName      String?
  actorRole      String?   // ADMIN, BRANCH, SUPPLIER, MASTER
  
  remarks        String?
  createdAt      DateTime  @default(now())

  @@index([vin])
  @@index([jobId])
  @@index([jobNumber])
  @@index([action])
  @@index([createdAt])
}

// ประวัติการ Sync รถจาก D365 (ใช้เป็น lock กันรันซ้อนด้วย)
model D365SyncRun {
  id          String    @id @default(uuid())
  trigger     String    // SCHEDULED | MANUAL
  triggeredBy String?   // ชื่อผู้กด (กรณี MANUAL)
  status      String    // RUNNING | SUCCESS | PARTIAL | FAILED
  startedAt   DateTime  @default(now())
  finishedAt  DateTime?
  fetched     Int       @default(0) // จำนวนแถวที่ดึงจาก D365
  created     Int       @default(0)
  updated     Int       @default(0)
  restocked   Int       @default(0) // OUT_OF_STOCK -> AVAILABLE
  outOfStock  Int       @default(0) // AVAILABLE -> OUT_OF_STOCK
  skipped     Int       @default(0)
  errors      String?   @db.NVarChar(Max) // JSON array

  @@index([startedAt])
  @@index([status])
}
