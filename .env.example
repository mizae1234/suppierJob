# Database Connection String for Microsoft SQL Server
# Format: sqlserver://<host>:<port>;database=<database_name>;user=<username>;password=<password>;encrypt=true;trustServerCertificate=true;
DATABASE_URL="sqlserver://localhost:1433;database=SupplierJobDB;user=sa;password=YourStrongPassword123!;encrypt=true;trustServerCertificate=true;"

# Next.js Environment
NODE_ENV="development"
NEXT_PUBLIC_APP_NAME="Supplier Job Management (EV7 & GI)"

# Google Places API (New) key — optional, falls back to OpenStreetMap
GOOGLE_MAPS_API_KEY=""

# Google Gemini API key — optional, provides AI Thai place search and reasoning
GEMINI_API_KEY=""

# Session signing secret (required, min 32 chars). Generate with: openssl rand -base64 48
SESSION_SECRET=""

# Local upload fallback dir when S3 is not configured (keep outside public/)
UPLOAD_DIR="./storage/uploads"

# Set to "true" to store new uploads as public-read on S3 (default: private, served via /api/files)
S3_PUBLIC_UPLOADS="false"

# ── Microsoft Dynamics 365 (D365 FO) Integration ──
# OAuth client credentials (Azure Entra ID App Registration)
D365_TENANT_ID=""
D365_CLIENT_ID=""
D365_CLIENT_SECRET=""
# Base URL ของ D365 (UAT: https://com7-uat.sandbox.operations.dynamics.com)
D365_BASE_URL=""
# เปิด sync รถจาก D365 อัตโนมัติ ("true" เพื่อเปิด) และรอบเวลา (นาที)
D365_SYNC_ENABLED="false"
D365_SYNC_INTERVAL_MINUTES="60"
